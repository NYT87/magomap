{
  "manifest_version": 3,
  "name": "magomap",
  "version": "0.1.0",
  "description": "Reads your Kakao Map lists for magomap's Sync from Kakao Map.",
  "key": "",
  "action": {
    "default_title": "Use Sync from Kakao Map in magomap"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://map.kakao.com/*"],
  "externally_connectable": {
    "matches": [
      "https://magomap.jmn8718.workers.dev/*",
      "http://localhost:5173/*",
      "http://localhost:8787/*"
    ]
  }
}
