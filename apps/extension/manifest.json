{
  "manifest_version": 3,
  "name": "magomap",
  "version": "0.1.4",
  "description": "Reads your Kakao Map lists for magomap's Sync from Kakao Map, and copies a list to Kakao Map when you ask in magomap.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open magomap to sync from Kakao Map",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://map.kakao.com/*"
  ]
}
